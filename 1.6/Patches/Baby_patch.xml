<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationReplace">
		<xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="Alien_Miho"]/alienRace/graphicPaths/body/extendedGraphics/BodyType[@For="Baby"]/path</xpath>
		<value>
			<path>Miho/Body/Naked_Baby</path>
		</value>
		<!-- <success>Always</success> 吞掉的失败：目标 Alien_Miho 不在场（玩家只装了本模组的一份
		     Defs 而它加载失败），或工坊本体改了 headOffsetDirectional 的层级导致某几条 xpath 0 命中。
		     这两种情况下「什么都不做」比刷 7 条 Patch operation failed 更合适。
		     真正的验证判据是进游戏看 4~11 岁美狐的贴图（见 About 里那 5 项）。 -->
		<success>Always</success>
	</Operation>

